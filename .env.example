# ===== Ember 环境配置示例 =====
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。

# 必填：LLM API Key（OpenAI 或兼容服务的密钥）
OPENAI_API_KEY=sk-你的密钥

# 可选：API 地址。默认 https://api.openai.com/v1
# 若自定义，必须包含 /v1 后缀（代码直接拼接 /chat/completions）
# 例如：https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：模型名称。默认 gpt-3.5-turbo
# 例如：gpt-4o、deepseek-chat
OPENAI_MODEL=gpt-3.5-turbo
